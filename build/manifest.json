{
  "manifest_version": 3,
  "name": "PoE Trade Helper - Abyss Jewels",
  "version": "2.1.0",
  "description": "Streamlined Path of Exile trading for Abyss Jewels with fuzzy search and tier conversion",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PoE Trade Helper - Abyss Jewels",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.pathofexile.com/trade/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json",
        "abyss_jewels.json",
        "abyss_jewels_mods.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}